    <string name="manage_confirm_power_title">%2$s இல் “%1$s” செய்யவா?</string>
    <string name="manage_confirm_wake_message">%1$s க்கு எழுப்பு கோரிக்கையை அனுப்பு. சாதனமும் அதன் வலையமைப்பும் Wake-on-LAN ஐ ஆதரித்தால் மட்டுமே இது வேலை செய்யும்.</string>
    <string name="manage_confirm_restart_message">%1$s க்கு மீண்டும் தொடங்கு கோரிக்கையை அனுப்பு. சேமிக்காத வேலை இழக்கப்படலாம், திறந்த அமர்வுகள் துண்டிக்கப்படும்.</string>
    <string name="manage_confirm_shutdown_message">%1$s க்கு அணைப்பு கோரிக்கையை அனுப்பு. சேமிக்காத வேலை இழக்கப்படலாம், சாதனம் மீண்டும் இயக்கப்படும் வரை அணைந்திருக்கும்.</string>
    <string name="manage_confirm_sleep_message">%1$s க்கு உறக்கம் கோரிக்கையை அனுப்பு. திறந்த அமர்வுகள் துண்டிக்கப்படும்.</string>
    <string name="manage_confirm_service_title">%2$s சேவைக்கு %1$s?</string>
    <string name="manage_confirm_service_message">%3$s இல் “%2$s” சேவைக்கு %1$s கோரிக்கையை அனுப்பு. அதைச் சார்ந்த திறந்த அமர்வுகள் பாதிக்கப்படலாம்.</string>
